#### 				"description": "Generated from cURL: \r\ncurl 'http://127.0.0.1:54321/rest/v1/bookings?select=*' \\\r\n-H \"apikey: SUPABASE_CLIENT_ANON_KEY\" \\\r\n-H \"Authorization: Bearer SUPABASE_CLIENT_ANON_KEY\"\r\n          "  
#### 			},  
#### 			"response": []  
#### 		},  
